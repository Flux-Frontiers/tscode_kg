
.kgcache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / TS (target repos will have these)
node_modules/
dist/
.next/
.nuxt/

# === KG generated artifacts (normalized across the fleet) ===
# Databases, vector indexes and model caches are transient and
# reproducible. snapshots/ is TRACKED and must never be ignored --
# never use a bare `**/.<ns>/` pattern here, it swallows snapshots too.

**/.pycodekg/lancedb/
**/.pycodekg/lancedb-*
**/.pycodekg/*.sqlite
**/.pycodekg/*.sqlite-shm
**/.pycodekg/*.sqlite-wal
**/.pycodekg/*.db
**/.pycodekg/models

**/.dockg/lancedb/
**/.dockg/lancedb-*
**/.dockg/*.sqlite
**/.dockg/*.sqlite-shm
**/.dockg/*.sqlite-wal
**/.dockg/*.db
**/.dockg/models
**/.dockg/embeddings.json

**/.tscodekg/lancedb/
**/.tscodekg/lancedb-*
**/.tscodekg/*.sqlite
**/.tscodekg/*.sqlite-shm
**/.tscodekg/*.sqlite-wal
**/.tscodekg/*.db
**/.tscodekg/models

# Agent scratch dirs (Claude Code / Codex)
.agents/
.codex/

# MCP server config -- machine-specific, contains absolute paths
.mcp.json
.mcp.json.sav
# === end KG generated artifacts ===
